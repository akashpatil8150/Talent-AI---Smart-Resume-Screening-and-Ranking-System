# ============================================================================
# AI Resume Screening System - Environment Configuration Template
# ============================================================================
# 
# This file documents all available environment variables for the AI Resume
# Screening application. Copy this file to .env and customize the values for
# your deployment environment.
#
# Usage:
#   1. Copy this file: cp .env.example .env
#   2. Generate SECRET_KEY: python -c "import os; print(os.urandom(24).hex())"
#   3. Update values in .env file
#   4. Never commit .env to version control
#
# ============================================================================

# ----------------------------------------------------------------------------
# Flask Application Configuration
# ----------------------------------------------------------------------------

# SECRET_KEY: Flask session encryption key (REQUIRED for production)
# - Must be at least 32 characters (48+ recommended)
# - Use cryptographically secure random string
# - Generate with: python -c "import os; print(os.urandom(24).hex())"
# - NEVER commit this value to version control
# Default: Auto-generated random key (not persistent across restarts)
SECRET_KEY=your-secret-key-here-replace-with-48-char-random-string

# FLASK_DEBUG: Enable Flask debug mode (ONLY for development)
# - Set to "true" for development (enables auto-reload, detailed errors)
# - Set to "false" for production (REQUIRED for security)
# - Debug mode exposes sensitive information - NEVER enable in production
# Default: false
FLASK_DEBUG=false

# PORT: Port number for the web server
# - Cloud platforms (Render, Railway, Heroku) set this automatically
# - For local development, use 5000 or any available port
# - Must be an integer between 1024-65535
# Default: 5000
PORT=5000

# ----------------------------------------------------------------------------
# Data Configuration
# ----------------------------------------------------------------------------

# CANDIDATE_CSV: Path to the candidate dataset CSV file
# - Relative or absolute path to candidates.csv
# - File must contain: Candidate_ID, Name, Email, Experience_Years, Skills, Category, Resume_Summary
# - For production, ensure file is included in deployment package
# Default: candidates.csv
CANDIDATE_CSV=candidates.csv

# TOP_N_DEFAULT: Default number of top candidates to return
# - Controls how many results are shown by default
# - Users can override this in the UI
# - Must be a positive integer
# Default: 100
TOP_N_DEFAULT=100

# ----------------------------------------------------------------------------
# TF-IDF Configuration (Keyword-Based Matching)
# ----------------------------------------------------------------------------

# MAX_FEATURES: Maximum number of features for TF-IDF vectorizer
# - Higher values = more detailed matching but more memory usage
# - Lower values = faster but less precise matching
# - Recommended: 100000-200000 for large datasets
# Default: 150000
MAX_FEATURES=150000

# MIN_DF: Minimum document frequency for TF-IDF
# - Terms must appear in at least this many documents to be included
# - Higher values = fewer features, faster processing
# - Lower values = more features, better coverage
# Default: 2
MIN_DF=2

# ----------------------------------------------------------------------------
# BERT Configuration (Semantic Matching)
# ----------------------------------------------------------------------------

# BERT_MODEL_NAME: HuggingFace model identifier for BERT encoder
# - all-MiniLM-L6-v2: Fast, 384-dim embeddings, ~90MB (RECOMMENDED)
# - all-mpnet-base-v2: Better quality, 768-dim, ~420MB (slower)
# - paraphrase-MiniLM-L6-v2: Alternative fast model
# - See: https://huggingface.co/sentence-transformers
# Default: sentence-transformers/all-MiniLM-L6-v2
BERT_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# BERT_BATCH_SIZE: Number of texts to encode in each batch
# - Higher values = faster but more memory usage
# - Lower values = slower but works on limited memory
# - Recommended: 8 for 1GB RAM, 16 for 2GB RAM, 32 for 4GB+ RAM
# - Reduce to 4 or 2 if you encounter out-of-memory errors
# Default: 8
BERT_BATCH_SIZE=8

# BERT_DEVICE: Device to use for BERT model
# - "auto": Automatically detect GPU or fallback to CPU
# - "cpu": Force CPU (recommended for cloud free-tier)
# - "cuda": Force GPU (requires CUDA-compatible GPU)
# - CPU is slower but works everywhere
# Default: auto
BERT_DEVICE=auto

# BERT_FORCE_CPU: Force CPU even if GPU is available
# - Set to "true" for cloud deployments (free-tier usually no GPU)
# - Set to "false" to use GPU if available
# - Overrides BERT_DEVICE setting
# Default: true (for production stability)
BERT_FORCE_CPU=true

# SKIP_BERT_PRECOMPUTE: Skip pre-computing embeddings at startup
# - Set to "true" for faster startup (embeddings computed on-demand)
# - Set to "false" to pre-compute all embeddings at startup (3-5 min)
# - Recommended: "true" for cloud deployments (faster health checks)
# - If cache exists on disk, it will be loaded regardless
# Default: true
SKIP_BERT_PRECOMPUTE=true

# ----------------------------------------------------------------------------
# Matching Mode Configuration
# ----------------------------------------------------------------------------

# MATCHING_MODE: Algorithm to use for candidate matching
# - "bert": Use only BERT semantic similarity (best quality, slower)
# - "tfidf": Use only TF-IDF keyword matching (fast, good for exact matches)
# - "hybrid": Average BERT and TF-IDF scores (balanced, RECOMMENDED)
# - If BERT fails to load, automatically falls back to TF-IDF
# Default: hybrid
MATCHING_MODE=hybrid

# ----------------------------------------------------------------------------
# Cache Configuration
# ----------------------------------------------------------------------------

# CACHE_DIR: Directory to store pre-computed BERT embeddings
# - Embeddings are cached to disk for fast loading on restart
# - Cache file is typically 50-100MB for 50K candidates
# - Ensure this directory is included in deployments
# - Path is relative to application root
# Default: .bert_cache
CACHE_DIR=.bert_cache

# TRANSFORMERS_CACHE: Directory to store downloaded BERT models
# - HuggingFace models are cached here (~90-400MB depending on model)
# - First run downloads model, subsequent runs load from cache
# - Path is relative to application root
# Default: ./.cache
TRANSFORMERS_CACHE=./.cache

# ----------------------------------------------------------------------------
# Platform-Specific Configuration
# ----------------------------------------------------------------------------

# PYTHON_VERSION: Python version for platform (Render, Railway, etc.)
# - Typically set by platform from runtime.txt
# - Only needed if platform requires explicit environment variable
# Default: 3.11.7
# PYTHON_VERSION=3.11.7

# FLASK_ENV: Flask environment mode
# - "production": Production mode (recommended)
# - "development": Development mode (local only)
# Default: production
# FLASK_ENV=production

# ----------------------------------------------------------------------------
# Advanced Configuration (Usually not needed)
# ----------------------------------------------------------------------------

# MAX_CONTENT_LENGTH: Maximum file upload size in bytes
# - Currently hardcoded to 200MB in app.py
# - Uncomment to override (value in bytes)
# Default: 209715200 (200MB)
# MAX_CONTENT_LENGTH=209715200

# LOG_LEVEL: Logging verbosity
# - "DEBUG": Verbose logging (development)
# - "INFO": Standard logging (production)
# - "WARNING": Only warnings and errors
# - "ERROR": Only errors
# Default: INFO
# LOG_LEVEL=INFO

# WORKERS: Number of Gunicorn worker processes
# - Typically set in Procfile or platform configuration
# - Recommended: 2-4 workers for production
# - More workers = more memory usage
# Default: 2 (set in Procfile)
# WORKERS=2

# TIMEOUT: Gunicorn worker timeout in seconds
# - How long to wait for requests to complete
# - Increase if you have slow queries or large datasets
# Default: 120 (set in Procfile)
# TIMEOUT=120

# ============================================================================
# Deployment Platform Examples
# ============================================================================

# --- Render ---
# Render auto-generates SECRET_KEY and sets PORT automatically
# Set these in Render dashboard:
#   SECRET_KEY: (auto-generated)
#   BERT_FORCE_CPU: true
#   SKIP_BERT_PRECOMPUTE: true
#   MATCHING_MODE: hybrid

# --- Railway ---
# Railway auto-detects PORT
# Set these in Railway dashboard:
#   SECRET_KEY: (generate with: openssl rand -hex 32)
#   BERT_FORCE_CPU: true
#   SKIP_BERT_PRECOMPUTE: true
#   MATCHING_MODE: hybrid

# --- Heroku ---
# Heroku sets PORT automatically
# Set these with: heroku config:set KEY=VALUE
#   SECRET_KEY: (generate with: openssl rand -hex 32)
#   BERT_FORCE_CPU: true
#   SKIP_BERT_PRECOMPUTE: true
#   MATCHING_MODE: hybrid

# --- Docker ---
# Pass environment variables with: docker run -e KEY=VALUE
# Or use docker-compose.yml with env_file: .env
#   SECRET_KEY: (generate with: openssl rand -hex 32)
#   BERT_FORCE_CPU: true
#   SKIP_BERT_PRECOMPUTE: true
#   MATCHING_MODE: hybrid
#   PORT: 8080

# --- Local Development ---
# For local development, use these settings:
#   SECRET_KEY: (any random string for testing)
#   FLASK_DEBUG: true
#   PORT: 5000
#   BERT_FORCE_CPU: false (use GPU if available)
#   SKIP_BERT_PRECOMPUTE: false (pre-compute for faster queries)
#   MATCHING_MODE: hybrid

# ============================================================================
# Security Notes
# ============================================================================
#
# 1. NEVER commit .env file to version control
# 2. Add .env to .gitignore (already done)
# 3. Use different SECRET_KEY for each environment
# 4. Rotate SECRET_KEY periodically in production
# 5. Use platform secret management for production (Render Secrets, etc.)
# 6. Never log or expose SECRET_KEY in application code
# 7. Use HTTPS in production (handled by platform)
#
# ============================================================================
# Troubleshooting
# ============================================================================
#
# Issue: "BERT model download fails"
# Solution: Check internet connection, try different model, or use TF-IDF mode
#
# Issue: "Out of memory error"
# Solution: Reduce BERT_BATCH_SIZE to 4 or 2, or use MATCHING_MODE=tfidf
#
# Issue: "Startup timeout"
# Solution: Set SKIP_BERT_PRECOMPUTE=true for faster startup
#
# Issue: "SECRET_KEY not set warning"
# Solution: Generate and set SECRET_KEY environment variable
#
# Issue: "Port already in use"
# Solution: Change PORT to different value or kill process using the port
#
# ============================================================================
